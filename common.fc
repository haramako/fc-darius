function outside(x:int, y:int):int
{
	return (x < 8 || x > 240 || y < 8 || y > 240);
}

public function no_effect():void {}

public function my_add_score(n:*int):void
{
	bcd.bcd_add(my_score, 6, n);
	my_score_changed = 1;
}
