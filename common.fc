public const GIFF_TABLE = [0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15];

function outside(x:u8, y:u8):u8
{
	return (x < 8 || x > 240 || y < 8 || y > 240);
}

public function no_effect():void {}

public function my_add_score(n:*u8):void
{
	bcd.bcd_add(my_score, 6, n);
	my_score_changed = 1;
}
