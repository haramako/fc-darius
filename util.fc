#fc 3
use nes;
use mmc3;
use util;

@include("util.asm");

@(bank: -1);

var vsync_flag:u8;
public var ppu_ctrl1_bak:u8; // = 0b10000000;
public var ppu_ctrl2_bak:u8; // = 0b00011110;
public var ppu_scroll1:u8;
public var ppu_scroll2:u8;

const GR_MAX = 8;
public var gr_idx:u8;
var gr_to_buf:[GR_MAX]u16;
var gr_from_buf:[GR_MAX]*u8;
var gr_size_buf:[GR_MAX]u8;
var gr_sprite_idx:u8;
var gr_sprite_buf:[256]u8 @(address: 0x0700);

public var pad_a:u8;
var pad_b:u8;
var pad_select:u8;
public var pad_start:u8;
public var pad_up:u8;
public var pad_down:u8;
public var pad_left:u8;
public var pad_right:u8;

var ppu_put_to:u16;
var ppu_put_from:*u8 @(address: 0x71);
var ppu_put_size:u8;
var interrupt_i:u8;

public function wait_vsync():void
{
	while (gr_sprite_idx < 255) {
		gr_sprite_buf[gr_sprite_idx] = 255;
		gr_sprite_idx += 1;
	}
	vsync_flag = 1;
	while (vsync_flag) {}
}

public function ppu_lock():void
{
	nes.PPU_CTRL1 = 0b00000000;
	nes.PPU_CTRL2 = 0b00000000;
}

public function ppu_unlock():void
{
	nes.PPU_CTRL1 = 0b10000000;
	vsync_flag = 1;
	wait_vsync();
}

public function ppu_put(to:u16, from_:*u8, size:u8):void;
public function ppu_put16(to:u16, from_:*u8, size:u16):void;
public function ppu_fill(to:u16, pat:u8, size:u16):void;

public function gr_add(to:u16, from_:*u8, size:u8):void
{
	while (gr_idx >= GR_MAX) {
		vsync_flag = 2;
		while (vsync_flag) {}
	}
	gr_from_buf[gr_idx] = from_;
	gr_to_buf[gr_idx] = to;
	gr_size_buf[gr_idx] = size;
	gr_idx += 1;
}

public function gr_pos(x:u8, y:u8):u16;

public function gr_sprite(x:u8, y:u8, pat:u8, mode:u8):void;
public function gr_sprites(x:u8, y:u8, data:*u8):void;

function gr_sprite2x2(x:u8, y:u8, pat:u8, mode:u8):void
{
	gr_sprite(x, y, pat, mode);
	gr_sprite(x + 8, y, pat + 1, mode);
	gr_sprite(x, y + 8, pat + 16, mode);
	gr_sprite(x + 8, y + 8, pat + 17, mode);
}

public function pad_update():void
{
	nes.PAD_CTRL = 1;
	nes.PAD_CTRL = 0;
	pad_a = nes.PAD_CTRL % 2;
	pad_b = nes.PAD_CTRL % 2;
	pad_select = nes.PAD_CTRL % 2;
	pad_start = nes.PAD_CTRL % 2;
	pad_up = nes.PAD_CTRL % 2;
	pad_down = nes.PAD_CTRL % 2;
	pad_left = nes.PAD_CTRL % 2;
	pad_right = nes.PAD_CTRL % 2;
}

function memset(p:*u8, c:u8, size:u8):void;
function memzero(p:*u8, size:u8):void;
function memcpy(from_:*u8, to:*u8, size:u8):void;

function wait(n:u8):void
{
	while (n) {
		var i:u8 = 55;
		while (i) {
			var j:u8 = 255;
			while (j) {
				j -= 1;
			}
			i -= i;
		}
		n -= 1;
	}
}
