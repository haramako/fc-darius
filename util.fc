#fc 2
use nes;
use mmc3;
use util;

include("util.asm");

options(bank: -1);

var vsync_flag:int;
public var ppu_ctrl1_bak:int; // = 0b10000000;
public var ppu_ctrl2_bak:int; // = 0b00011110;
public var ppu_scroll1:int;
public var ppu_scroll2:int;

const GR_MAX = 8;
public var gr_idx:int;
var gr_to_buf:[GR_MAX]int16;
var gr_from_buf:[GR_MAX]*int;
var gr_size_buf:[GR_MAX]int;
var gr_sprite_idx:int;
var gr_sprite_buf:[256]int options(address: 0x0700);

public var pad_a:int;
var pad_b:int;
var pad_select:int;
public var pad_start:int;
public var pad_up:int;
public var pad_down:int;
public var pad_left:int;
public var pad_right:int;

var ppu_put_to:int16;
var ppu_put_from:*int options(address: 0x40);
var ppu_put_size:int;
var interrupt_i:int;

public function wait_vsync():void
{
	while (gr_sprite_idx < 255) {
		gr_sprite_buf[gr_sprite_idx] = 255;
		gr_sprite_idx += 1;
	}
	vsync_flag = 1;
	while (vsync_flag) {}
}

public function ppu_lock():void
{
	nes.PPU_CTRL1 = 0b00000000;
	nes.PPU_CTRL2 = 0b00000000;
}

public function ppu_unlock():void
{
	nes.PPU_CTRL1 = 0b10000000;
	vsync_flag = 1;
	wait_vsync();
}

public function ppu_put(to:int16, from_:*int, size:int):void;
public function ppu_put16(to:int16, from_:*int, size:int16):void;
public function ppu_fill(to:int16, pat:int, size:int16):void;

public function gr_add(to:int16, from_:*int, size:int):void
{
	while (gr_idx >= GR_MAX) {
		vsync_flag = 2;
		while (vsync_flag) {}
	}
	gr_from_buf[gr_idx] = from_;
	gr_to_buf[gr_idx] = to;
	gr_size_buf[gr_idx] = size;
	gr_idx += 1;
}

public function gr_pos(x:int, y:int):int16;

public function gr_sprite(x:int, y:int, pat:int, mode:int):void;
public function gr_sprites(x:int, y:int, data:*int):void;

function gr_sprite2x2(x:int, y:int, pat:int, mode:int):void
{
	gr_sprite(x, y, pat, mode);
	gr_sprite(x + 8, y, pat + 1, mode);
	gr_sprite(x, y + 8, pat + 16, mode);
	gr_sprite(x + 8, y + 8, pat + 17, mode);
}

public function pad_update():void
{
	nes.PAD_CTRL = 1;
	nes.PAD_CTRL = 0;
	pad_a = nes.PAD_CTRL % 2;
	pad_b = nes.PAD_CTRL % 2;
	pad_select = nes.PAD_CTRL % 2;
	pad_start = nes.PAD_CTRL % 2;
	pad_up = nes.PAD_CTRL % 2;
	pad_down = nes.PAD_CTRL % 2;
	pad_left = nes.PAD_CTRL % 2;
	pad_right = nes.PAD_CTRL % 2;
}

function memset(p:*int, c:int, size:int):void;
function memzero(p:*int, size:int):void;
function memcpy(from_:*int, to:*int, size:int):void;

function wait(n:int):void
{
	while (n) {
		var i:int = 55;
		while (i) {
			var j:int = 255;
			while (j) {
				j -= 1;
			}
			i -= i;
		}
		n -= 1;
	}
}
