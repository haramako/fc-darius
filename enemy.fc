#fc 3
use math;
use util;
use * from common;

@include("enemy.asm");

@(bank: -1);

/*********************************************
 * 敵関係のルーチン
 *********************************************/

/** 初期化する */
// function en_init: void(){}
public function en_init():void
{
	var i:u8;
	en_bul_free = 0;
	for (i = 0; i < EN_BUL_MAX; i++) {
		en_bul_x[i] = i + 1;
	}
}

public function en_process():void
{
	var i:u8;
	for (i = 0; i < EN_MAX; i++) {
		var type = en_type[i];
		EN_PROCESS[type](i);
	}
}

const en_new = ->fn():u8 {
	var i:u8;
	for (i = 0; i < EN_MAX; i++) {
		if (!en_type[i]) {
			return i;
		}
	}
	return 255;
};

// 敵の弾の処理
public function en_bul_process():void;

/**
 * 新しい敵の弾を生成して、そのインデックスを返す.
 * 取得できなかった場合は、255を返す
 */
function en_bul_new():u8
{
	if (en_bul_free >= EN_BUL_MAX) {
		return 255;
	}
	var n = en_bul_free;
	en_bul_free = en_bul_x[en_bul_free];
	return n;
}

/**
 * 角度を指定して玉を打つ
 */
function en_bul_new_angle(x:u8, y:u8, angle:u8, speed:u8):void
{
	var n = en_bul_new();
	if (n == 255) {
		return;
	}
	en_bul_type[n] = 1;
	en_bul_x[n] = x;
	en_bul_y[n] = y;
	en_bul_vx[n] = math.cos(angle) / speed;
	en_bul_vy[n] = -math.sin(angle) / speed;
}

/**
 * 角度を指定して玉を打つ
 */
public function en_bul_nway(x:u8, y:u8, angle:u8, speed:u8, way:u8, spread:u8):void
{
	var i:u8;
	angle = angle - ((way - 1) * spread) / 2;
	for (i = 0; i < way; i++) {
		var n = en_bul_new();
		if (n == 255) {
			return;
		}
		en_bul_type[n] = 1;
		en_bul_x[n] = x;
		en_bul_y[n] = y;
		en_bul_vx[n] = math.cos(angle) / speed;
		en_bul_vy[n] = -math.sin(angle) / speed;
		angle += spread;
	}
}

/** 敵と自機の弾の当たり判定を行う */
public function en_check_hit(x:u8, y:u8, w:u8, h:u8):u8
{
	var j:u8;
	for (j = 0; j < MY_BUL_MAX; j++) {
		if (my_bul_type[j] == 1 && x + w / 2 - my_bul_x[j] < w && y + h / 2 - my_bul_y[j] < h) {
			my_bul_type[j] = 0;
			my_bul_vx[j] = 0;
			return 1;
		}
	}
	return 0;
}

/*********************************************
 * ダミー
 *********************************************/
function en_none_process(i:u8):void {}

/*********************************************
 * 爆発
 *********************************************/
public function bang_new(x:u8, y:u8):void
{
	var i = en_new();
	if (i != -1) {
		en_type[i] = 1;
		en_x[i] = x;
		en_y[i] = y;
		en_p1[i] = 0;
	}
}

const BANG_SPR:[?]u8 = [8, 0x14, 0x02, 0,
	1, 0x16, 0x02, 8,
	16, 0x36, 0x02, 8,
	12, 0x1a, 0x02, 16,
	0];

const BANG_SPR1:[?]u8 = [8, 0x3a, 0xc2, 0,
	8, 0x38, 0xc2, 8,
	1, 0x18, 0x02, 16,
	24, 0x18, 0xc2, 8,
	16, 0x38, 0x02, 16,
	16, 0x3a, 0x02, 24,
	0];

const BANG_SPR2:[?]u8 = [1, 0x3e, 0xc2, 0,
	1, 0x3c, 0xc2, 8,
	16, 0x1e, 0xc2, 0,
	16, 0x1c, 0xc2, 8,
	1, 0x1c, 0x02, 16,
	1, 0x1e, 0x02, 24,
	16, 0x3c, 0x02, 16,
	16, 0x3e, 0x02, 24,
	0];

function bang_process(i:u8):void
{
	var p1 = en_p1[i];
	if (p1 < 24) {
		if (p1 || anim_count % 8 == 4) {
			p1 = p1 / 8;
			switch (p1) {
			case 0:
				util.gr_sprites(en_x[i] - 16, en_y[i] - 8, BANG_SPR);
			case 1:
				util.gr_sprites(en_x[i] - 16, en_y[i] - 8, BANG_SPR1);
			case 2:
				util.gr_sprites(en_x[i] - 16, en_y[i] - 8, BANG_SPR2);
			}
			en_p1[i] += 1;
		}
	} else {
		en_type[i] = 0;
	}
}

const EN_PROCESS:[?]fn(u8):void = [en_none_process, bang_process];
